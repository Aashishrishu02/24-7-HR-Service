generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum ProductType {
  VPS_HOSTING
  LINUX_IP_VPS
}

enum OrderStatus {
  PENDING
  PAID
  PROVISIONING
  ACTIVE
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentPurpose {
  VPS_ORDER
  WALLET_TOPUP
  VPS_RENEWAL
  SMARTVPS_ORDER
}

enum PaymentProvider {
  RAZORPAY
  WALLET
}

enum SmartVpsOrderStatus {
  PAYMENT_PENDING
  PAID
  PROVISIONING
  ACTIVE
  PROVISIONING_FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
}

enum VPSStatus {
  PENDING
  RUNNING
  STOPPED
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ConsentAction {
  CONSENT_GRANTED
  CONSENT_REVOKED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  MAINTENANCE
  EXPIRED
  SUSPENDED
  FAILED
}

enum ProvisioningStatus {
  PENDING
  CHECKING_INVENTORY
  RESERVED
  PURCHASING
  PROVISIONING
  COMPLETED
  RETRYING
  FAILED
  CANCELLED
}

enum ProvisioningSource {
  INVENTORY
  PROVIDER_API
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  VPS_TECHNICAL
  BILLING_WALLET
  DEDICATED_IP
  ACCOUNT_GENERAL
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailOtps       EmailVerificationOtp[]
  passwordOtps    PasswordResetOtp[]
  vpsInstances    VPSInstance[]
  orders          Order[]
  wallet          Wallet?
  payments        Payment[]
  smartVpsOrders  SmartVpsOrder[]
  consentAudits   VPSConsentAudit[]
  renewalAttempts RenewalAttempt[]
  notifications   NotificationLog[]
  supportTickets  SupportTicket[]

  @@index([role])
  @@index([isActive])
}

model EmailVerificationOtp {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// ADMIN
// ==========================================

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  priceHistory PriceHistory[]

  @@index([isActive])
}

// ==========================================
// WALLET & TRANSACTIONS
// ==========================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id             String                @id @default(uuid())
  walletId       String
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(10, 2)
  currency       String                @default("INR")
  reference      String?
  idempotencyKey String                @unique
  description    String
  metadata       Json?
  paymentId      String?
  createdAt      DateTime              @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, type])
  @@index([walletId, createdAt])
  @@index([reference])
  @@index([type])
  @@index([paymentId])
}

// ==========================================
// VPS PLANS
// ==========================================

model VPSPlan {
  id          String      @id @default(uuid())
  name        String
  productType ProductType
  description String?

  cpuCores    Int
  ramGb       Int
  storageGb   Int
  bandwidthGb Int?

  price        Decimal @db.Decimal(10, 2)
  currency     String  @default("INR")
  durationDays Int

  supportedOS String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            Order[]
  providerMappings  VPSPlanProviderMapping[]
  priceHistory      PriceHistory[]
  hostHeavenMapping HostHeavenPlanMapping?

  @@index([productType])
  @@index([isActive])
}

// ==========================================
// CUSTOMER ORDERS
// ==========================================

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  userId String
  planId String

  planName        String
  operatingSystem String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan             VPSPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments         Payment[]
  vpsInstance      VPSInstance?
  provisioningJobs ProvisioningJob[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// PAYMENTS
// ==========================================

model SmartVpsOrder {
  id                String              @id @default(uuid())
  userId            String
  ramGb             Int
  planName          String
  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("INR")
  status            SmartVpsOrderStatus @default(PAYMENT_PENDING)
  idempotencyKey    String              @unique @default(uuid())
  providerIp        String?             @unique
  providerUsername  String?
  passwordEncrypted String?
  provisioningError String?
  paidAt            DateTime?
  provisionedAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
}

model Payment {
  id              String  @id @default(uuid())
  userId          String
  orderId         String?
  smartVpsOrderId String?

  purpose  PaymentPurpose
  provider PaymentProvider @default(RAZORPAY)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("INR")
  status   PaymentStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  smartVpsOrder      SmartVpsOrder?      @relation(fields: [smartVpsOrderId], references: [id], onDelete: Restrict)
  walletTransactions WalletTransaction[]

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([smartVpsOrderId])
  @@index([status])
  @@index([purpose])
  @@index([provider])
}

// ==========================================
// VPS PROVIDERS
// ==========================================

model Provider {
  id String @id @default(uuid())

  name    String
  code    String  @unique
  baseUrl String?

  isActive           Boolean @default(true)
  apiPurchaseEnabled Boolean @default(false)

  priority Int @default(100)

  maxPurchaseAmount Decimal? @db.Decimal(10, 2)
  currency          String   @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential ProviderCredential?
  products   ProviderProduct[]
  inventory  ProviderInventory[]
  mappings   VPSPlanProviderMapping[]
  jobs       ProvisioningJob[]

  dedicatedIpPlans     DedicatedIpPlan[]
  dedicatedIpSyncState DedicatedIpSyncState?

  @@index([isActive, priority])
}

// ==========================================
// DEDICATED IP CATALOGUE
// ==========================================

model DedicatedIpPlan {
  id String @id @default(uuid())

  providerId     String
  externalPlanId String
  planName       String

  categoryId         String?
  categoryName       String?
  tier               String?
  tierLabel          String?
  controlMode        String?
  protocol           String?
  supportedProtocols String[] @default([])

  countryCode String?
  countryName String?
  location    String?
  duration    String?
  speed       String?
  minQuantity Int?

  regularPrice Decimal? @db.Decimal(10, 2)
  apiPrice     Decimal? @db.Decimal(10, 2)
  currency     String   @default("INR")

  inStock       Boolean @default(false)
  stock         Int?
  defaultSubnet String?
  poolsCount    Int     @default(0)

  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  pools    DedicatedIpPool[]

  @@unique([providerId, externalPlanId])
  @@index([providerId, isActive, inStock])
}

model DedicatedIpPool {
  id String @id @default(uuid())

  planId         String
  externalPoolId String
  poolName       String?
  subnet         String?
  location       String?

  regularPrice Decimal? @db.Decimal(10, 2)
  apiPrice     Decimal? @db.Decimal(10, 2)
  currency     String   @default("INR")

  inStock   Boolean @default(false)
  stock     Int?
  isDefault Boolean @default(false)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan DedicatedIpPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, externalPoolId])
  @@index([planId, inStock])
}

model DedicatedIpSyncState {
  id String @id @default(uuid())

  providerId      String    @unique
  status          String    @default("NEVER_SYNCED")
  lastAttemptAt   DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  syncedPlanCount Int       @default(0)
  syncedPoolCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
}

model ProviderCredential {
  id         String @id @default(uuid())
  providerId String @unique

  usernameEncrypted  String?
  passwordEncrypted  String?
  apiKeyEncrypted    String?
  apiSecretEncrypted String?

  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderProduct {
  id String @id @default(uuid())

  providerId        String
  externalProductId String

  name        String
  productType ProductType

  cpuCores    Int
  ramGb       Int
  storageGb   Int
  bandwidthGb Int?

  region      String?
  supportedOS String[] @default([])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider                 @relation(fields: [providerId], references: [id], onDelete: Restrict)
  mappings VPSPlanProviderMapping[]

  @@unique([providerId, externalProductId])
  @@index([providerId, isActive])
}

model ProviderInventory {
  id String @id @default(uuid())

  providerId    String
  providerVpsId String

  ipAddress String?
  hostname  String?

  cpuCores    Int
  ramGb       Int
  storageGb   Int
  bandwidthGb Int?

  region          String?
  operatingSystem String?

  providerCost Decimal @db.Decimal(10, 2)
  currency     String  @default("INR")

  status InventoryStatus @default(AVAILABLE)

  expiresAt DateTime?

  encryptedAccessDetails String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider         Provider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  vpsInstance      VPSInstance?
  provisioningJobs ProvisioningJob[]

  @@unique([providerId, providerVpsId])
  @@index([status, region])
  @@index([providerId, status])
}

model VPSPlanProviderMapping {
  id String @id @default(uuid())

  planId            String
  providerId        String
  providerProductId String

  priority Int @default(100)

  isEnabled           Boolean @default(true)
  autoPurchaseEnabled Boolean @default(false)

  maxAllowedCost Decimal? @db.Decimal(10, 2)

  regionMapping Json?
  osMapping     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan            VPSPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerProduct ProviderProduct @relation(fields: [providerProductId], references: [id], onDelete: Restrict)

  @@unique([planId, providerId, providerProductId])
  @@index([planId, isEnabled, priority])
}

// ==========================================
// VPS INSTANCES ASSIGNED TO CUSTOMERS
// ==========================================

model VPSInstance {
  id String @id @default(uuid())

  userId  String
  orderId String? @unique

  inventoryId String? @unique

  provider      String
  providerVpsId String? @unique

  ipAddress       String  @unique
  hostname        String?
  operatingSystem String?

  ram    Int?
  status VPSStatus @default(PENDING)

  expiresAt            DateTime?
  autoRenew            Boolean   @default(false)
  autoRenewConsentAt   DateTime?
  autoRenewDisabledAt  DateTime?
  gracePeriodDays      Int       @default(3)
  gracePeriodExpiresAt DateTime?
  suspendedAt          DateTime?
  providerSuspended    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  inventory       ProviderInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  consentAudits   VPSConsentAudit[]
  renewalAttempts RenewalAttempt[]
  notifications   NotificationLog[]
  supportTickets  SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([autoRenew, status, expiresAt])
}

// ==========================================
// VPS CONSENT AUDIT
// ==========================================

model VPSConsentAudit {
  id       String        @id @default(uuid())
  vpsId    String
  userId   String
  action   ConsentAction
  actionAt DateTime      @default(now())

  vps  VPSInstance @relation(fields: [vpsId], references: [id], onDelete: Restrict)
  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([vpsId, actionAt])
  @@index([userId, actionAt])
}

// ==========================================
// SYSTEM SETTINGS
// ==========================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

// ==========================================
// PROVISIONING JOBS
// ==========================================

model ProvisioningJob {
  id String @id @default(uuid())

  orderId     String
  providerId  String?
  inventoryId String?

  source ProvisioningSource @default(INVENTORY)
  status ProvisioningStatus @default(PENDING)

  attemptNumber Int @default(1)

  idempotencyKey String @unique

  providerRequestId String?

  errorCode    String?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider  Provider?          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  inventory ProviderInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, createdAt])
  @@index([providerId, status])
}

// ==========================================
// VPS SELLING PRICE HISTORY
// ==========================================

model PriceHistory {
  id String @id @default(uuid())

  planId           String
  changedByAdminId String?

  oldPrice Decimal @db.Decimal(10, 2)
  newPrice Decimal @db.Decimal(10, 2)

  currency String @default("INR")

  createdAt DateTime @default(now())

  plan  VPSPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  admin Admin?  @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([changedByAdminId])
}

// ==========================================
// VPS AUTO-RENEWAL ATTEMPTS & AUDIT
// ==========================================

model RenewalAttempt {
  id                String    @id @default(uuid())
  vpsId             String
  userId            String
  status            String // SUCCESS, INSUFFICIENT_FUNDS, FAILED, SKIPPED
  renewalAmount     Decimal   @db.Decimal(10, 2)
  walletBalance     Decimal?  @db.Decimal(10, 2)
  previousExpiresAt DateTime?
  newExpiresAt      DateTime?
  paymentId         String?
  errorMessage      String?
  idempotencyKey    String    @unique
  attemptedAt       DateTime  @default(now())

  vps  VPSInstance @relation(fields: [vpsId], references: [id], onDelete: Restrict)
  user User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([vpsId, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([status])
}

// ==========================================
// NOTIFICATION LOG & IDEMPOTENCY
// ==========================================

model NotificationLog {
  id             String   @id @default(uuid())
  userId         String
  vpsId          String?
  type           String // EXPIRY_WARNING, RENEWAL_SUCCESS, RENEWAL_FAILED, INSUFFICIENT_BALANCE, VPS_SUSPENDED, GRACE_PERIOD_WARNING, VPS_TERMINATED
  channel        String   @default("EMAIL")
  recipient      String
  subject        String
  content        String?
  metadata       Json?
  idempotencyKey String   @unique
  sentAt         DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  vps  VPSInstance? @relation(fields: [vpsId], references: [id], onDelete: SetNull)

  @@index([userId, type, sentAt])
  @@index([vpsId, type])
}

// ==========================================
// HOSTHEAVEN PLAN MAPPING
// ==========================================

model HostHeavenPlanMapping {
  id String @id @default(uuid())

  planId String @unique

  externalConfigId String?   @unique
  isCostVerified   Boolean   @default(false)
  costStatus       String    @default("ESTIMATED") // ESTIMATED or VERIFIED
  lastSyncedAt     DateTime?

  pricingDetails Json?

  zoneId    String
  zoneName  String?
  zoneIsoId String
  isoName   String?
  planType  String // SHARED or DEDICATED

  cpuPricingId       String
  cpuName            String?
  ramPricingId       String
  ramName            String?
  diskPricingId      String
  diskName           String?
  bandwidthPricingId String
  bandwidthName      String?

  providerCost Decimal @db.Decimal(10, 2)
  currency     String  @default("INR")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan VPSPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, isActive])
  @@index([zoneId])
  @@index([externalConfigId])
  @@index([isCostVerified])
}

// ==========================================
// CUSTOMER SUPPORT TICKETING
// ==========================================

model SupportTicket {
  id            String  @id @default(uuid())
  ticketNumber  Int     @default(autoincrement())
  userId        String
  vpsInstanceId String?
  orderId       String?

  subject  String
  category TicketCategory @default(VPS_TECHNICAL)
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpsInstance VPSInstance?    @relation(fields: [vpsInstanceId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]

  @@index([userId, status])
  @@index([status, priority])
  @@index([ticketNumber])
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  senderId    String
  senderRole  UserRole @default(CUSTOMER)
  senderName  String
  message     String   @db.Text
  attachments String[] @default([])

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}
